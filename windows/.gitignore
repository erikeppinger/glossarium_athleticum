flutter/ephemeral/

# Local MSIX signing identity (see build_msix.ps1's header comment) - a
# throwaway self-signed test certificate generated once per
# machine/checkout and reused across builds. Never commit a private key,
# even a disposable local-only one.
test_cert.pfx
test_cert.cer

# Visual Studio user-specific files.
*.suo
*.user
*.userosscache
*.sln.docstates

# Visual Studio build-related files.
x64/
x86/

# Visual Studio cache files
# files ending in .cache can be ignored
*.[Cc]ache
# but keep track of directories ending in .cache
!*.[Cc]ache/

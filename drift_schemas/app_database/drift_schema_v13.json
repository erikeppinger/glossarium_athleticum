          "sql": "CREATE TABLE IF NOT EXISTS \"exercises\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"category\" TEXT NOT NULL, \"movement_pattern\" TEXT NOT NULL, \"muscle_groups\" TEXT NOT NULL, \"equipment\" TEXT NOT NULL, \"difficulty\" TEXT NOT NULL, \"measurement_type\" TEXT NOT NULL, \"description\" TEXT NOT NULL DEFAULT '', \"safety_notes\" TEXT NOT NULL DEFAULT '', \"video_reference\" TEXT NOT NULL DEFAULT '', \"is_custom\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_custom\" IN (0, 1)), \"source_plan_name\" TEXT NULL, \"author\" TEXT NULL, \"image_path\" TEXT NULL, \"image_paths\" TEXT NULL, \"is_favorite\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_favorite\" IN (0, 1)), PRIMARY KEY (\"id\"));"
